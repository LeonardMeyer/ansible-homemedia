# Managed by Ansible — do not edit manually
mode: iptables
update_frequency: 10s
log_mode: file
log_dir: /var/log/
log_level: info
log_compression: true
log_max_size: 100
log_max_backups: 3
log_max_age: 30
api_url: http://127.0.0.1:8080/
api_key: "{{ crowdsec__bouncer_api_key }}"
insecure_skip_verify: false
disable_ipv6: false
deny_action: DROP
deny_log: false
deny_log_prefix: "crowdsec: "
blacklists_ipv4: crowdsec-blacklists
blacklists_ipv6: crowdsec6-blacklists
ipset_size: 131072
ipset_type: nethash
iptables_chains:
  - INPUT
  - DOCKER-USER
